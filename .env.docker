# =============================================================
# Atheres Atlas — Docker Environment Variables
#
# USAGE:
#   cp .env.docker .env          (Git-ignored — safe for secrets)
#   docker compose --env-file .env up
#   OR rename to .env and docker compose picks it up automatically
#
# ⚠  Never commit .env to source control.
# =============================================================

# -----------------------------------------------------------
# SQL Server  (shared by app DB and Service Bus emulator)
# Must be >=8 chars, mix of upper/lower/digit/symbol
# -----------------------------------------------------------
MSSQL_SA_PASSWORD=Atlas@Str0ngPwd!

# -----------------------------------------------------------
# Azure SignalR Service
# ⚠ No local emulator exists — requires a real Azure resource.
# Free tier (F1) is sufficient for development.
# Portal: SignalR Service → Keys → Primary Connection String
# Service mode must be "Serverless"
# -----------------------------------------------------------
AZURE_SIGNALR_CONNECTION=Endpoint=https://<your-signalr>.service.signalr.net;AccessKey=<key>;Version=1.0;

# -----------------------------------------------------------
# Google Maps Platform
# Enable: Geocoding API + Directions API
# console.cloud.google.com → APIs & Services → Credentials
# -----------------------------------------------------------
GOOGLE_MAPS_API_KEY=<your-google-maps-api-key>

# -----------------------------------------------------------
# SendGrid
# app.sendgrid.com → Settings → API Keys → Full Mail Send
# -----------------------------------------------------------
SENDGRID_API_KEY=SG.<your-sendgrid-api-key>
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=Atheres Atlas Delivery

# -----------------------------------------------------------
# Twilio
# console.twilio.com → Account Info
# Phone number in E.164 format: +15551234567
# -----------------------------------------------------------
TWILIO_ACCOUNT_SID=AC<your-account-sid>
TWILIO_AUTH_TOKEN=<your-auth-token>
TWILIO_FROM_NUMBER=+15551234567

# -----------------------------------------------------------
# Public URL used in email confirmation links
# Change to your domain / ngrok URL when testing externally
# -----------------------------------------------------------
FUNCTION_HOST_URL=http://localhost

# -----------------------------------------------------------
# JWT Authentication  (used by Atheres.Atlas.Auth.Functions)
# JwtSecretKey must be at least 32 characters — use a random value in production
# Generate one: openssl rand -base64 32
# -----------------------------------------------------------
JWT_SECRET_KEY=<your-jwt-secret-key-min-32-chars>
JWT_ISSUER=http://localhost
JWT_AUDIENCE=http://localhost
JWT_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# Optional: seed the global administrator (SuperAdmin) on first container start
# This account is cross-tenant and has full platform access.
# Leave blank to skip seeding.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# -----------------------------------------------------------
# Environment
# Development | Staging | Production
# -----------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
